# Copy to the repo root as `.env` and fill in OPENAI_API_KEY. Everything else
# has a working default for a standard local run.
#
# The root is the only .env this project reads. There is no `backend/.env`:
# the Mastra agent is imported as source by frontend/server.ts and runs inside
# the Copilot Runtime process, and `mastra dev` is never started, so a key
# placed under backend/ would never reach anything.
#
# Note who reads this file. `node ci/automate.mjs` (npm run automate) loads it
# and passes it to the servers it starts, and frontend/server.ts loads it
# itself on startup, so `npm run dev` by hand picks it up too. A variable
# already exported in the shell wins over the value here.

# REQUIRED. The model key. Only the runtime process holds it; it never reaches
# the browser. The model id itself is hardcoded in
# backend/src/mastra/agents/index.ts, so there is no model override here.
OPENAI_API_KEY=sk-...

# REQUIRED. CopilotKit Intelligence key; frontend/server.ts passes it to
# CopilotKitIntelligence, which serves the thread endpoints (/threads).
# The key scopes the Intelligence project, so use this project's own key.
CPK_INTELLIGENCE_API_KEY=

# Port the Copilot Runtime listens on. Default: 8200.
# The Angular app's runtimeUrl in frontend/src/app/app.config.ts is hardcoded to
# 8200, so change both together or the browser posts into nothing.
PORT=8200

# Port the CI pipeline expects `ng serve` on. Default: 4200.
# FRONTEND_PORT=4200

# Opt out of CopilotKit's anonymous runtime telemetry.
# COPILOTKIT_TELEMETRY_DISABLED=true
